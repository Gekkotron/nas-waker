#!/bin/bash
# Power the Pi off after the nightly backup window.
# Runs once per boot, ON_MINUTES after boot (systemd timer).
# Only acts when the Pi booted inside the nightly window (scheduled wake-up);
# a boot at any other time (e.g. to watch a film) keeps the Pi on.
# Usage: nightly-autoshutdown [--dry-run] [--window HH:MM-HH:MM]
set -u

WINDOW_START=22:45     # boot inside [start,end] = scheduled nightly wake-up
WINDOW_END=23:30
RECHECK_MIN=5          # while FTP/DLNA is busy, re-check every N minutes
MAX_ON_MIN=180         # never stay on longer than this after a nightly boot
FTP_PORTS="21 40000-40100"
DLNA_PORTS="8200"
DRY_RUN=0
[ -r /etc/default/nightly-autoshutdown ] && . /etc/default/nightly-autoshutdown

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --window) WINDOW_START=${2%-*}; WINDOW_END=${2#*-}; shift ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
  shift
done

log() { logger -t nightly-autoshutdown "$*"; echo "$*"; }
tomin() { local h=${1%:*} m=${1#*:}; echo $((10#$h * 60 + 10#$m)); }
synced() { [ "$(timedatectl show -p NTPSynchronized --value)" = yes ]; }

# No RTC on a Pi 4: the clock is only right once NTP has synced.
for _ in $(seq 1 60); do synced && break; sleep 10; done
if ! synced; then log "clock not synchronised, cannot tell boot time: staying on"; exit 0; fi

uptime_s() { cut -d. -f1 /proc/uptime; }
boot_epoch=$(( $(date +%s) - $(uptime_s) ))
boot_hm=$(date -d "@$boot_epoch" +%H:%M)
boot_min=$(tomin "$boot_hm")
if (( boot_min < $(tomin "$WINDOW_START") || boot_min > $(tomin "$WINDOW_END") )); then
  log "booted at $boot_hm, outside nightly window $WINDOW_START-$WINDOW_END (manual start): staying on"
  exit 0
fi

# Count established TCP connections on FTP (control + passive data) and DLNA ports.
busy_count() {
  ss -Htn state established | awk -v ports="$FTP_PORTS $DLNA_PORTS" '
    BEGIN { n = split(ports, p, " ") }
    { k = split($3, a, ":"); port = a[k] + 0
      for (i = 1; i <= n; i++) {
        if (split(p[i], r, "-") == 2) { if (port >= r[1] && port <= r[2]) { c++; break } }
        else if (port == p[i] + 0) { c++; break }
      } }
    END { print c + 0 }'
}

while :; do
  busy=$(busy_count)
  up_min=$(( $(uptime_s) / 60 ))
  if (( busy == 0 )); then
    log "nightly boot at $boot_hm, up ${up_min} min, no FTP/DLNA activity: powering off"
    break
  fi
  if (( up_min >= MAX_ON_MIN )); then
    log "nightly boot at $boot_hm, up ${up_min} min, $busy connection(s) still open but max ${MAX_ON_MIN} min reached: powering off"
    break
  fi
  log "$busy FTP/DLNA connection(s) active, re-checking in ${RECHECK_MIN} min"
  [ "$DRY_RUN" = 1 ] && exit 0
  sleep $(( RECHECK_MIN * 60 ))
done

[ "$DRY_RUN" = 1 ] && { log "(dry run: not powering off)"; exit 0; }
systemctl poweroff
